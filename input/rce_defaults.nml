! Optional-key defaults for the rce_long driver. Passed as `defaults_file` to the
! radiation-knob reads so a namelist that omits them inherits these values instead
! of erroring (the rest of rce_long's &rce keys remain required, fail-loud). Keep
! rad_interval in step with aeros_rad_class's default (6 h).
&rce
    rad_interval = 21600.0
    rad_scheme   = 2
    restart_in       = ""
    restart_out      = ""
    restart_interval = 0
/
