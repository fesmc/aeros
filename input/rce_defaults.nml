! Optional-key defaults for the rce_long driver. Passed as `defaults_file` to the
! radiation- and topography-knob reads so a namelist that omits them inherits these
! values instead of erroring (the rest of rce_long's &rce keys remain required,
! fail-loud). Keep rad_interval in step with aeros_rad_class's default (6 h).
! l_topography off = flat aquaplanet (phis = 0), the bit-for-bit default.
&rce
    ! Isothermal semi-implicit reference temperature [K] (aeros_semiimp requires
    ! isothermal). Optional; omitted -> this default.
    t_ref            = 300.0
    ! The SpeedyWeather-faithful dynamical core (docs/refs/sw_faithful_dynamics.md)
    ! is the default: del^8 hyperdiffusion on 4 h, divergence on 1 h with the
    ! order tapered to del^4 above sigma = 0.2 (tau_diff_div/diff_taper below),
    ! backward-implicit gravity waves (si_alpha = 1), no Rayleigh sponge.
    ! eps_filter/raw_alpha are the RAW time-filter coefficients and only act
    ! under time_scheme = "leapfrog" (SpeedyWeather's 0.1 / 0.53).
    tau_diff         = 4.0
    ndiff            = 8
    eps_filter       = 0.1
    raw_alpha        = 0.53
    l_sponge         = .false.
    ! Sponge strengths, used only when l_sponge = .true.: max Rayleigh and
    ! Newtonian rates [1/s] and the ramp top [sigma].
    sponge_kr        = 2.3148e-5
    sponge_kt        = 1.1574e-5
    sponge_sigma     = 0.12
    ! Van Leer (2nd-order monotone) vertical humidity transport instead of the
    ! default first-order upwind donor cell. Off by default (bit-for-bit).
    vert_vanleer     = .true.
    ! Diagnostic prescribed heating (dry-core heating->omega isolation). Off by
    ! default; when on, set all physics off. amp in K/day.
    l_qforce         = .false.
    qforce_amp       = 2.0
    rad_interval     = 21600.0
    rad_scheme       = 2
    l_topography     = .false.
    topo_file        = "/Users/alrobi001/data/era5/era5_orography.nc"
    topo_ramp_days   = 20.0
    ! Convection scheme. "sbm" (default) = Simplified Betts-Miller with the
    ! strictly-buoyant band; "sbm_frierson" = the same closure with Frierson's
    ! surface-to-LZB depth + integrated Pt/Pq trigger (stays active at RCE, dries
    ! the free troposphere); "manabe" = the reference pairwise scheme.
    conv_scheme      = "sbm_frierson"
    conv_rh_ref      = 0.6
    conv_rh_ref_bl   = 0.85
    ! Boundary-layer vertical diffusion. richardson = .true. diagnoses the mixed-
    ! layer depth from the bulk Richardson number (Frierson 2006 / SpeedyWeather);
    ! .false. uses the legacy fixed vdiff_sigma depth. Both diffuse dry static
    ! energy. ri_crit is the critical bulk Richardson number.
    vdiff_richardson = .true.
    vdiff_ri_crit    = 10.0
    ! Reevaporation efficiency of falling large-scale precip into sub-saturated
    ! layers (SpeedyWeather's ImplicitCondensation reevaporation; 0 disables it).
    cond_reevap      = 30.0
    ! Fraction 1/cond_time_scale of the saturation adjustment (and reevaporation)
    ! applied per step (SpeedyWeather ImplicitCondensation time_scale = 3).
    cond_time_scale  = 3.0
    ! Land surface + land-sea mask (feat/land). l_land off = all-ocean
    ! aquaplanet, the bit-for-bit default. Files are ERA5 climatologies.
    l_land           = .false.
    lsm_file         = "/Users/alrobi001/data/era5/monthly-single-levels/era5_monthly-single-levels_lsm_1991-2020_clim.nc"
    land_albedo_file = "/Users/alrobi001/data/era5/monthly-single-levels/era5_monthly-single-levels_fal_1991-2020_clim.nc"
    w_field_capacity = 0.15
    w_crit           = -1.0
    ! Effective seasonal soil heat capacity [J m-2 K-1] (~2.5e6 J m-3 K-1 over the
    ! ~2 m annual penetration depth). Recalibrated 2026-09-06 with the seasonal
    ! albedo: 2e6 -> 5e6 keeps JJA NH-land T within ~1 K of ERA5; 1e7 trades a
    ! 3.6 K JJA cold bias for 3 K less DJF cold. The DJF cold (7-13 K, whole lower
    ! troposphere at 60-70N, land and ocean) is not a land-scheme problem.
    c_soil           = 5.0e6
    land_albedo      = 0.20
    ! Monthly ERA5 fal as the bare land albedo (interpolated daily) instead of
    ! its annual mean, which is snow-contaminated (0.36 at 65N) and leaves summer
    ! high-latitude land ~6 K too cold. With it the snow bump is redundant.
    land_albedo_seasonal = .true.
    snow_albedo      = -1.0            ! snow-albedo feedback cold endpoint; <0 = off (bit-for-bit)
    snow_dt          = 5.0             ! ramp width [K] below T0
    restart_in       = ""
    restart_out      = ""
    restart_interval = 0
    ! Prognostic cloud fraction (feat/clouds). l_cloud_prog off = the diagnostic
    ! RH->cover scheme, bit-for-bit unchanged. When on, radiation consumes the
    ! Sundqvist prognostic cf instead. rhc_* is the critical-RH profile (higher
    ! aloft than at the surface); tau_form/tau_evap are the formation/evaporation
    ! timescales [s]; c_detr weights the convective detrainment source. The knobs
    ! are calibrated (m2_results) to a realistic ~0.55 aquaplanet cloud cover; the
    ! several-hour timescales let cf transport de-patchify the field, which keeps
    ! the coupled land+cloud run stable (a 1 h timescale leaves it patchy enough
    ! to spin up a runaway near-equatorial jet).
    ! Diagnostic RH-based cloud scheme (l_rad_clouds, l_cloud_prog = .false.):
    ! critical-RH endpoints at the surface / model top (Sundqvist fraction) and
    ! in-cloud liquid / ice water contents [kg m-3]. Calibrated 2026-09-06 on the
    ! coupled L6 real-Earth run against ERA5's TOA budget: rhc_top above 1 puts
    ! the lid layer's threshold at ~1 (that layer, 0-250 hPa, sits at RH 90% by
    ! construction and its "cloud" was a black 231 K deck under 65% cover: CRE
    ! -113/+67 W/m2 vs ERA5 -46/+22). With these: CRE -56/+31, cover 0.52
    ! (ERA5 0.63), net TOA +2 with the clear-sky budget already at ERA5's
    ! (absorbed 288/289, OLR 261/264), P 2.7 mm/day. The module's own defaults
    ! (0.52/0.35, 0.017/0.018) are the offline ERA5-column calibration
    ! (docs/m2_results.md section 19) and stay for validate_era5.
    cld_rhc_sfc      = 0.52
    cld_rhc_top      = 1.40
    cld_lwc          = 0.035e-3
    cld_iwc          = 0.014e-3
    l_cloud_prog     = .false.
    cloud_rhc_sfc    = 0.40
    cloud_rhc_top    = 0.60
    cloud_tau_form   = 10800.0
    cloud_tau_evap   = 10800.0
    cloud_c_detr     = 0.5
    ! Sea ice off = freeze-floor slab, the bit-for-bit default. When on (needs a
    ! slab ocean, ocean_mode = 1) the mixed-layer deficit forms ice instead of
    ! being clamped, and the ice albedo feeds back into the radiation.
    l_seaice         = .false.
    ice_albedo       = 0.60
    k_ice            = 2.0
    t_frz            = 271.35
    ! Adaptive hyperdiffusion (feat/adaptive-diff). Both OFF = the fixed
    ! del^ndiff scheme, bit-for-bit unchanged. (1) diff_adapt scales the
    ! diffusion coefficient per level by 1 + gain*max(0, |zeta|_rms/zeta_ref - 1),
    ! capped at diff_adapt_max, damping a spiking jet where and when it grows.
    ! (2) diff_taper lowers the order toward the model top (del^ndiff ->
    ! del^diff_ndiff_top above diff_taper_sigma) on the DIVERGENCE (gravity-wave)
    ! modes only -- SpeedyWeather's implicit top sponge; vorticity/temperature
    ! keep the full untapered order.
    diff_adapt       = .false.
    diff_zeta_ref    = 1.0e-4
    diff_adapt_gain  = 1.0
    diff_adapt_max   = 10.0
    diff_taper       = .true.
    diff_ndiff_top   = 4
    diff_taper_sigma = 0.2
    ! Divergence-only diffusion e-folding time [h] (SpeedyWeather runs the
    ! divergent modes on a shorter timescale than vorticity/temperature to absorb
    ! upward-propagating gravity waves at the lid). 0 = use tau_diff -> bit-for-bit.
    tau_diff_div     = 1.0
    ! Semi-implicit decentering weight on X^(n+1): 0.5 = centered (neutral gravity
    ! waves, bit-for-bit default), 1.0 = backward-implicit (SpeedyWeather; damps
    ! the fast gravity + computational modes in the solve).
    si_alpha         = 1.0
    ! Time scheme (src/dynamics/aeros_timestep.f90, "The Lorenz N-cycle"):
    ! "leapfrog" (RAW-filtered semi-implicit leapfrog; eps_filter/raw_alpha
    ! apply) or "ncycle" (two-time-level semi-implicit Lorenz N-cycle, Hotta et
    ! al. 2016; no time filter, physics on the one time chain). ncycle = N,
    ! ncycle_variant = A | B | AB | ABBA (ABBA is 4th order for N = 4).
    time_scheme      = "ncycle"
    ncycle           = 4
    ncycle_variant   = "A"
    ! Speed-limit drag (SpeedyWeather's default SpeedLimitDrag): quadratic drag
    ! on the wind speed above drag_vmax [m/s], coefficient drag_coef [1/m]; 0 = off.
    drag_vmax        = 70.0
    drag_coef        = 4.0e-7
    ! Surface wind the bulk fluxes and the momentum drag see (SpeedyWeather's
    ! SurfaceCondition): sqrt((wind_slowdown*|V_low|)^2 + gust_speed^2).
    gust_speed       = 5.0
    wind_slowdown    = 0.95
    ! Bulk exchange coefficients: <= 0 = SpeedyWeather's bulk-Richardson log-law
    ! kappa^2/ln^2(z1/z0)*(1-Ri/Ri_c)^2 diagnosed per point (one coefficient for
    ! heat, moisture and momentum); > 0 pins a fixed value. c_d = 0 = no drag.
    c_h              = -1.0
    c_e              = -1.0
    c_d              = -1.0
    z0_ocean         = 1.0e-4
    z0_land          = 0.5
    ! Prescribed-SST meridional profile: T_s = T0 + sst_eq*(1 - sin^2(sst_shape*phi))
    ! for |phi| < sst_lat. Defaults are the APE Control profile (gradient steepest at
    ! 30 deg). sst_shape=1.0 + sst_lat=90 gives SpeedyWeather's cos^2(phi).
    sst_eq           = 27.0
    sst_lat          = 60.0
    sst_shape        = 1.5
    ! Seasonal insolation (feat/seasonal). .false. = annual-mean insolation
    ! (bit-for-bit default). .true. drives a seasonal cycle from the Laskar orbit;
    ! doy0 is the start day-of-year.
    l_seasonal       = .false.
    doy0             = 0.0
    ! Monthly-mean climatology output path (feat/seasonal). "" = off (bit-for-bit
    ! default). Set to a .nc path to bin zonal-mean T/u/RH/v (lat,lev,month) and
    ! SST/precip (lat,month) by calendar month for the ERA5 seasonal comparison.
    monthly_out      = ""
    ! Spin-up days excluded from the monthly climatology (0 = accumulate all).
    mon_spinup_days  = 0.0
    ! Prescribed seasonal SST table (feat/seasonal). "" = off (static analytic
    ! profile). A .nc with sst(lat,month) on the model grid (scripts/
    ! make_seasonal_sst.jl) overrides SST daily in prescribed-SST mode.
    sst_seasonal_file = ""

    ! Prescribed analytic ozone in the radiation (stratospheric SW heating and
    ! the LW ozone band). .false. is a diagnostic: it leaves the lid moisture
    ! and temperature unchanged (2026-09-06 test), so it is not a tuning lever.
    l_o3             = .true.
/
