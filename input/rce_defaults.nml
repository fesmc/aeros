! Optional-key defaults for the rce_long driver. Passed as `defaults_file` to the
! radiation- and topography-knob reads so a namelist that omits them inherits these
! values instead of erroring (the rest of rce_long's &rce keys remain required,
! fail-loud). Keep rad_interval in step with aeros_rad_class's default (6 h).
! l_topography off = flat aquaplanet (phis = 0), the bit-for-bit default.
&rce
    ! Isothermal semi-implicit reference temperature [K] (aeros_semiimp requires
    ! isothermal). Optional; omitted -> this default.
    t_ref            = 300.0
    ! Couple diabatic heating in-solve (step 1b) instead of the default forward
    ! split. Needs eps_filter ~0.15 for stability. Off by default (bit-for-bit).
    couple_diabatic  = .false.
    ! Van Leer (2nd-order monotone) vertical humidity transport instead of the
    ! default first-order upwind donor cell. Off by default (bit-for-bit).
    vert_vanleer     = .false.
    ! Diagnostic prescribed heating (dry-core heating->omega isolation). Off by
    ! default; when on, set all physics off. amp in K/day.
    l_qforce         = .false.
    qforce_amp       = 2.0
    rad_interval     = 21600.0
    rad_scheme       = 2
    l_topography     = .false.
    topo_file        = "/Users/alrobi001/data/era5/era5_orography.nc"
    topo_ramp_days   = 20.0
    ! Convection scheme. "sbm" (default) = Simplified Betts-Miller with the
    ! strictly-buoyant band; "sbm_frierson" = the same closure with Frierson's
    ! surface-to-LZB depth + integrated Pt/Pq trigger (stays active at RCE, dries
    ! the free troposphere); "manabe" = the reference pairwise scheme.
    conv_scheme      = "sbm_frierson"
    ! Boundary-layer vertical diffusion. richardson = .true. diagnoses the mixed-
    ! layer depth from the bulk Richardson number (Frierson 2006 / SpeedyWeather);
    ! .false. uses the legacy fixed vdiff_sigma depth. Both diffuse dry static
    ! energy. ri_crit is the critical bulk Richardson number.
    vdiff_richardson = .true.
    vdiff_ri_crit    = 10.0
    ! Reevaporation efficiency of falling large-scale precip into sub-saturated
    ! layers (SpeedyWeather's ImplicitCondensation reevaporation; 0 disables it).
    cond_reevap      = 30.0
    ! Land surface + land-sea mask (feat/land). l_land off = all-ocean
    ! aquaplanet, the bit-for-bit default. Files are ERA5 climatologies.
    l_land           = .false.
    lsm_file         = "/Users/alrobi001/data/era5/monthly-single-levels/era5_monthly-single-levels_lsm_1991-2020_clim.nc"
    land_albedo_file = "/Users/alrobi001/data/era5/monthly-single-levels/era5_monthly-single-levels_fal_1991-2020_clim.nc"
    w_field_capacity = 0.15
    w_crit           = -1.0
    c_soil           = 2.0e6
    land_albedo      = 0.20
    restart_in       = ""
    restart_out      = ""
    restart_interval = 0
    ! Prognostic cloud fraction (feat/clouds). l_cloud_prog off = the diagnostic
    ! RH->cover scheme, bit-for-bit unchanged. When on, radiation consumes the
    ! Sundqvist prognostic cf instead. rhc_* is the critical-RH profile (higher
    ! aloft than at the surface); tau_form/tau_evap are the formation/evaporation
    ! timescales [s]; c_detr weights the convective detrainment source. The knobs
    ! are calibrated (m2_results) to a realistic ~0.55 aquaplanet cloud cover; the
    ! several-hour timescales let cf transport de-patchify the field, which keeps
    ! the coupled land+cloud run stable (a 1 h timescale leaves it patchy enough
    ! to spin up a runaway near-equatorial jet).
    l_cloud_prog     = .false.
    cloud_rhc_sfc    = 0.40
    cloud_rhc_top    = 0.60
    cloud_tau_form   = 10800.0
    cloud_tau_evap   = 10800.0
    cloud_c_detr     = 0.5
    ! Sea ice off = freeze-floor slab, the bit-for-bit default. When on (needs a
    ! slab ocean, ocean_mode = 1) the mixed-layer deficit forms ice instead of
    ! being clamped, and the ice albedo feeds back into the radiation.
    l_seaice         = .false.
    ice_albedo       = 0.60
    k_ice            = 2.0
    t_frz            = 271.35
    ! Adaptive hyperdiffusion (feat/adaptive-diff). Both OFF = the fixed
    ! del^ndiff scheme, bit-for-bit unchanged. (1) diff_adapt scales the
    ! diffusion coefficient per level by 1 + gain*max(0, |zeta|_rms/zeta_ref - 1),
    ! capped at diff_adapt_max, damping a spiking jet where and when it grows.
    ! (2) diff_taper lowers the order toward the model top (del^ndiff ->
    ! del^diff_ndiff_top above diff_taper_sigma) on the DIVERGENCE (gravity-wave)
    ! modes only -- SpeedyWeather's implicit top sponge; vorticity/temperature
    ! keep the full untapered order.
    diff_adapt       = .false.
    diff_zeta_ref    = 1.0e-4
    diff_adapt_gain  = 1.0
    diff_adapt_max   = 10.0
    diff_taper       = .false.
    diff_ndiff_top   = 4
    diff_taper_sigma = 0.15
    ! Divergence-only diffusion e-folding time [h] (SpeedyWeather runs the
    ! divergent modes on a shorter timescale than vorticity/temperature to absorb
    ! upward-propagating gravity waves at the lid). 0 = use tau_diff -> bit-for-bit.
    tau_diff_div     = 0.0
    ! Semi-implicit decentering weight on X^(n+1): 0.5 = centered (neutral gravity
    ! waves, bit-for-bit default), 1.0 = backward-implicit (SpeedyWeather; damps
    ! the fast gravity + computational modes in the solve).
    si_alpha         = 0.5
/
