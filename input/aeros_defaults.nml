&ctrl
    ! Times in YEARS. aeros_update converts to the dynamics timestep itself and
    ! derives the step count from the absolute elapsed time, so an output
    ! interval that is not a whole number of steps is fine and does not drift.
    !
    ! 0.1 yr at dt = 1800 s is ~1750 steps -- a smoke test rather than a
    ! simulation. There is no forcing until M1.5, so a run from the shipped
    ! initial condition (a resting isothermal atmosphere) should stay exactly
    ! where it started; that IS the check this default performs.
    time_init  = 0.0
    time_end   = 0.1
    dt_out     = 0.02
    file_out   = "aeros.nc"
/

&aeros
    ! Triangular truncation T.
    !   T21 ->  64x32   (ruled out for production: fails both NH ice sheets)
    !   T31 ->  96x48
    !   T42 -> 128x64
    !   T85 -> 256x128  (the reference truncation for the section 3.7 correction)
    !
    ! DEVELOPMENT DEFAULT: T31, for speed. This is NOT the production choice.
    !
    ! docs/design.md section 10.3 frames T31-plus-correction vs bare T42 as the
    ! central open question and expects the cost measurement to settle it. M0a
    ! has now removed the COST half of that argument -- T42 measures at ~14% of
    ! the coupled budget, not 82% (docs/m0a_results.md section 2) -- so T42 is
    ! affordable. What remains is the accuracy half, which no benchmark can
    ! answer: whether T42 alone builds the Eurasian ice sheet.
    !
    ! Decision (AR, 2026-07-24): stay at T31 for day-to-day work, test at T42
    ! periodically, and settle the production truncation with the full model
    ! rather than with the dynamical core. Nothing in the code may assume a
    ! value; changing this line is the only thing required to switch.
    !
    ! Wave 4a.2 (2026-09-10): this schema now carries the CALIBRATED real-Earth
    ! state that rce_long ran with (its former input/rce_defaults.nml and
    ! driver-local defaults, folded in here) -- T21L6, dt 1 h, the
    ! SpeedyWeather-faithful core, every physics subsystem on. A dry-core
    ! benchmark pins what it needs (par/held_suarez.nml).
    trunc    = 21

    ! Gaussian grid. -1 selects the smallest quadratically-unaliased grid for
    ! `trunc`, which is what production should use. Set explicitly only to
    ! study aliasing or to match another model's grid.
    nlon     = -1
    nlat     = -1

    ! Vertical levels. docs/design.md section 4.1: L16-20, with 3-4 levels
    ! below 850 hPa. Fix this before tuning anything -- level count moves the
    ! jet latitude, and therefore the storm track, and therefore ice-sheet
    ! precipitation. L6 is the production default (level sweep 2026-09-06:
    ! harness metrics as good as L8 and L12, 2860 vs 2190 SYPD); L8/L12 are
    ! namelist choices.
    nlev     = 6

    ! Dynamics timestep [s]. 1 h at T21L6 (the real-Earth harness; ~1850 SYPD
    ! with the in-solve physics coupling), ~30 min at T42 (section 4).
    !
    ! The semi-implicit solve is what makes this affordable: the explicit
    ! gravity-wave limit is ~600 s at T31L20 and ~450 s at T42, both printed at
    ! run start by aeros_semiimp_print. Raising dt above ~2x the ADVECTIVE CFL
    ! is not protected by the semi-implicit scheme -- it only handles the
    ! gravity waves.
    dt       = 3600.0

    ! Semi-implicit leapfrog (.TRUE.) or fully explicit leapfrog (.FALSE.).
    ! Explicit is not a production configuration; it exists so the value of the
    ! semi-implicit solve is measured rather than asserted. With it, dt must
    ! fall below the explicit limit above or the run diverges within ~20 steps.
    semi_implicit = .TRUE.
    ! Time scheme (src/dynamics/aeros_timestep.f90, "The Lorenz N-cycle"):
    ! "ncycle" (two-time-level semi-implicit Lorenz N-cycle, the production
    ! default; no time filter) or "leapfrog" (RAW-filtered semi-implicit
    ! leapfrog; eps_filter/raw_alpha apply). ncycle = N, ncycle_variant =
    ! A | B | AB | ABBA (ABBA is 4th order for N = 4).
    time_scheme    = "ncycle"
    ncycle         = 4
    ncycle_variant = "A"
    ! Speed-limit drag (SpeedyWeather's default SpeedLimitDrag): quadratic drag
    ! on the wind speed above drag_vmax [m/s], coefficient drag_coef [1/m]; 0 = off.
    drag_vmax      = 70.0
    drag_coef      = 4.0e-7

    ! Time filter. Williams (2009) RAW: nu is the classical Robert-Asselin
    ! coefficient and alpha splits the displacement between the two time
    ! levels. alpha = 1.0 recovers the classical filter exactly, which is the
    ! comparison to run if the filter is ever suspected.
    !
    ! nu = 0.1 is SpeedyWeather's Robert coefficient (the value that unlocked
    ! sustained eddies on the leapfrog core); alpha = 0.53 is Williams'
    ! recommended value, and buys third-order amplitude accuracy and exact
    ! conservation of the mean -- which is what matters over 10^5 yr, where the
    ! classical filter's mean damping is a slow drift rather than a transient.
    ! Both act only under time_scheme = "leapfrog".
    eps_filter = 0.1
    raw_alpha  = 0.53

    ! Horizontal hyperdiffusion, applied implicitly to vorticity, divergence
    ! and temperature (never to ln p_s -- that would leak mass).
    !
    ! The SpeedyWeather-faithful dynamical core (docs/refs/sw_faithful_dynamics.md)
    ! is the default: del^8 hyperdiffusion on 4 h, divergence on 1 h with the
    ! order tapered to del^4 above sigma = 0.2 (tau_diff_div / diff_taper
    ! below), backward-implicit gravity waves (si_alpha = 1), no Rayleigh
    ! sponge. ndiff is the order (6 = del^6 is the conventional T31-T85 choice;
    ! lower orders damp the resolved scales too broadly, higher ones act on the
    ! last wavenumber only). tau_diff [h] is the e-folding time of the l = lmax
    ! wave -- a TUNING parameter whose right value depends on truncation and on
    ! how vigorous the flow is; retune it when the truncation changes, against
    ! the enstrophy spectrum rather than the look of a single field.
    ndiff    = 8
    tau_diff = 4.0

    ! Semi-implicit decentering weight on X^(n+1): 0.5 centered (neutral on
    ! gravity waves), 1.0 backward-implicit (SpeedyWeather; damps the fast
    ! gravity + computational modes in the solve).
    si_alpha = 1.0
    ! Divergence-only diffusion e-folding time [h] (SpeedyWeather-style: the
    ! divergent/gravity-wave modes damped on their own, shorter timescale, to
    ! absorb upward-propagating gravity waves at the lid).
    ! <= 0 = use tau_diff, the single-timescale scheme.
    tau_diff_div = 1.0

    ! Adaptive hyperdiffusion (src/dynamics/aeros_timestep.f90 header). Both
    ! parts OFF = the fixed del^ndiff scheme, bit for bit.
    ! (1) vorticity-scaled strength: multiplier keyed to the level's RMS
    ! vorticity exceeding diff_zeta_ref [s-1], gain diff_adapt_gain, capped at
    ! diff_adapt_max.
    diff_adapt      = .FALSE.
    diff_zeta_ref   = 1.0e-4
    diff_adapt_gain = 1.0
    diff_adapt_max  = 10.0
    ! (2) sigma-tapered order on the DIVERGENCE (gravity-wave) modes only:
    ! order ramps from ndiff to diff_ndiff_top (even, <= ndiff) above sigma =
    ! diff_taper_sigma -- SpeedyWeather's implicit top sponge; vorticity and
    ! temperature keep the full untapered order. ON in the SW-faithful core.
    diff_taper       = .TRUE.
    diff_ndiff_top   = 4
    diff_taper_sigma = 0.2

    ! Upper-level sponge (aeros_timestep "Upper-level sponge"): implicit
    ! Rayleigh drag (rate sponge_kr [s-1]) and Newtonian cooling (sponge_kt) on
    ! the layers above sigma = sponge_sigma, squared-ramped to the top. OFF =
    ! bit for bit.
    l_sponge     = .FALSE.
    sponge_kr    = 2.3148e-5      ! 1/(0.5 d)
    sponge_kt    = 1.1574e-5      ! 1/(1 d)
    sponge_sigma = 0.12

    ! Non-rotating planet: zero Coriolis parameter (single-column RCE vehicle).
    l_nonrotating = .FALSE.

    ! Amplitude of the m>0 temperature seed in the "rce_warm" initial condition
    ! (aeros_set_rce_warm); 0 = axisymmetric start.
    seed_asym = 0.0

    ! SHTns setup: "quick" skips the auto-tuning (~20% slower transforms) and
    ! is the reproducible choice -- the same numbers in any directory, on any
    ! run. "cache" auto-tunes once per working directory and saves/loads the
    ! tuning, and is NOT self-reproducible: a reload can pick a different
    ! algorithm than the fresh tune, and the two modes differ at round-off in
    ! every transform. "quick" is the default (rce_long's choice, Wave 4a.2);
    ! par/held_suarez.nml pins "cache" for its bit-for-bit history.
    sht_mode = "quick"

    ! Held & Suarez (1994) idealized forcing -- the M1 validation benchmark
    ! (docs/design.md section 7). .FALSE. leaves the bare adiabatic core, which
    ! is what the conservation tests want and what this namelist's default
    ! resting initial condition should sit still in.
    !
    ! Run the benchmark with par/held_suarez.nml rather than by flipping this:
    ! the benchmark needs its own vertical grid (20 evenly spaced sigma levels)
    ! and its own run length, and those live together in one file so a
    ! Held-Suarez result cannot be produced from a half-converted namelist.
    held_suarez = .FALSE.

    ! Global mass fixer: rescale p_s at the end of every step so the global
    ! mass returns to its initial value (src/dynamics/aeros_timestep.f90).
    !
    ! OFF here, deliberately. This namelist is the bare core, and the adiabatic
    ! conservation tests must measure the integrator rather than the fixer --
    ! they hold mass at 2e-16 without it. The drift the fixer exists to remove
    ! is a property of the eddying forced state (docs/m1_results.md 5.3), so
    ! par/held_suarez.nml is where it is switched on.
    mass_fixer = .FALSE.

    ! OpenMP threads, i.e. the size of the SHTns config pool. -1 leaves it to
    ! OMP_NUM_THREADS. The M0a scaling sweep still has to be run at 16/32/64 on
    ! the HPC -- see docs/m0a_results.md section 4 caveat 4.
    nthreads = -1
/

&aeros_vert
    ! Vertical coordinate: hybrid sigma-pressure (Simmons & Burridge 1981),
    !     p_(k+1/2) = A_(k+1/2) + B_(k+1/2) * p_s
    ! generated from a stretched sigma profile. See src/dynamics/aeros_vertical.f90.

    ! Level placement. Spacing is proportional to stretch_a at the surface and
    ! to stretch_a + stretch_r*(1-stretch_a) at the top, so SMALLER stretch_a
    ! means finer resolution near the ground.
    !
    ! 0.4 / 2.0 gives 4 full levels below 850 hPa at L16 and 5 at L20 --
    ! docs/design.md section 4.1 asks for 3-4, because the polar winter
    ! boundary layer is 50-200 m deep with 10-25 K inversions -- while keeping
    ! 3 levels above 200 hPa. Section 4.1 also warns that level count moves the jet latitude
    ! and hence the storm track, so do not starve the upper troposphere to feed
    ! the boundary layer.
    !
    ! stretch_a = 1.0 gives EVENLY SPACED sigma, the Held-Suarez configuration.
    stretch_a = 0.4
    stretch_r = 2.0

    ! Hybrid transition: B = 0 (pure pressure) above this sigma, ramping to 1
    ! at the surface. 0.0 gives pure sigma exactly, with A = 0 everywhere.
    sigma_t   = 0.2

    ! Model top [Pa]. Low-top is accepted (docs/design.md section 4.1: give up
    ! on the QBO); must be > 0 for a hybrid coordinate.
    p_top     = 1000.0

    ! Reference state for the semi-implicit solve (M1.4). Isothermal, and
    ! deliberately warm: the scheme is stable when the reference temperature is
    ! at or above the column temperature and unstable well below it, so the
    ! error is one-sided.
    ps_ref    = 1.0e5
    t_ref     = 300.0
/

&aeros_correction
    ! The additive tendency correction (docs/design.md 3.7 and 3.8), applied
    ! spectrally on the assembled tendency -- see src/dynamics/aeros_correction.f90
    ! for why there rather than at the grid seam with the physics.
    !
    ! MASTER SWITCH. .FALSE. is section 3.8 mitigation 3's `DeltaF = 0` twin
    ! and reproduces the uncorrected model bit for bit. Every production run
    ! should have one; if conclusions differ qualitatively between the twin and
    ! the corrected run, say so.
    correction = .FALSE.

    ! How many of the arrays below are read.
    nterm = 1

    ! One term per column. At M2 the only term is a no-op: registered, wired
    ! in, exercised by tests/test_correction.f90, and identically zero. There
    ! is nothing to put in it until M2b diagnoses a real DeltaF from a T85/T31
    ! pair under identical boundary conditions.
    term_name    = "noop", "", "", "", "", "", "", ""
    term_enabled = .TRUE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE.

    ! Which prognostic fields each term acts on. Section 3.7 is explicit that
    ! a blanket correction on everything "is far more likely to destabilise and
    ! much harder to diagnose", and mwm/B_multires found exactly that.
    term_on_vor  = .TRUE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE.
    term_on_div  = .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE.
    term_on_temp = .TRUE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE.
    term_on_lnps = .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE., .FALSE.

    ! Spectral-scale selector: apply only where total wavenumber l <= this.
    ! -1 applies at every resolved scale. The stationary-wave error section 3.7
    ! targets lives at large scales, and restricting the correction to them is
    ! the first mitigation mwm/B_multires/B2B_OUTCOME.md lists for the
    ! instability its whole-field version hit.
    term_lcut    = -1, -1, -1, -1, -1, -1, -1, -1
/

&physics
    ! Master on/off flags for the physics subsystems (docs/coupling_api.md
    ! sec. 5, 8). THE source of each subsystem's enabled state on the library
    ! path (Wave 4a): aeros_init loads them and aeros_timestep_init hands each
    ! to its subsystem loader -- the per-group `enabled` keys are gone. The
    ! defaults are rce_long's driver defaults (Wave 4a.2): the moist column
    ! (surface fluxes, convection, condensation, radiation) and the lid
    ! Brewer-Dobson term on; the boundary-layer scheme, land and topography
    ! are case choices (mwm/D_realearth turns them on). A dry-core run
    ! (par/held_suarez.nml) switches everything off explicitly.
    ! The flags also gate the boundary providers (&boundary): l_land reads
    ! and applies lsm / albedo, l_rad dust / so4, l_topography phis (off =
    ! flat, whatever the provider holds), and the sst provider is applied in
    ! &ocean mode = 0 when the surface or radiation is on.
    l_surf        = .TRUE.      ! surface fluxes (&surface)
    l_cnv         = .TRUE.      ! moist convection (&aeros_moisture conv_*)
    l_cnd         = .TRUE.      ! large-scale condensation (&aeros_moisture)
    l_rad         = .TRUE.      ! radiation (&radiation)
    l_land        = .FALSE.     ! land surface (&land; &boundary lsm / albedo); off = all-ocean aquaplanet
    l_topography  = .FALSE.     ! real orography (&boundary phis); off = flat
    l_seaice      = .FALSE.     ! thermodynamic sea ice (&ocean ice_*; needs mode=1)
    l_cloud_prog  = .FALSE.     ! prognostic cloud fraction (&aeros_cloud); forces &radiation clouds on
    l_bd          = .TRUE.      ! lid Brewer-Dobson w* (&bd; also needs a file)
    l_vdiff       = .FALSE.     ! boundary-layer vertical diffusion (&vdiff)
/

&moisture_transport
    ! Positive-definite finite-volume tracer transport on the grid
    ! (src/dynamics/aeros_transport.f90). Reserved namelist group for the
    ! coupling API's per-subsystem loader; only knob today is the vertical
    ! reconstruction: .TRUE. (default) is the same van Leer (2nd-order
    ! monotone) limiter the horizontal sweeps use; .FALSE. the first-order
    ! upwind donor cell.
    vert_vanleer = .TRUE.
/

&aeros_moisture
    ! Large-scale condensation (src/physics/aeros_condensation.f90). The
    ! humidity transport itself is always on -- it costs nothing on a dry field
    ! -- the switch is &physics l_cnd (off in this schema, and in the
    ! Held-Suarez benchmark, which is dry by construction).

    ! Critical relative humidity for condensation: q relaxes to rh_crit*q_sat,
    ! so the column cannot equilibrate wetter than this where condensation is
    ! the moisture sink. 1.0 is true saturation adjustment; a lower value is the
    ! sub-grid-saturation stand-in for the missing subsidence drying that
    ! otherwise pins the free troposphere at RH ~100 % (m2_results s23). The
    ! real-Earth cases run 0.93.
    rh_crit = 0.95
    ! Condensation threshold for all-ice columns (T <= -23 C), blended with
    ! rh_crit by the liquid fraction; < 0 = single threshold. 0.80 since
    ! 2026-09-08: with the single 0.93 every cold column sat at the threshold
    ! (winter cap RH 82-94 % vs ERA5 60-80, LW down over NH winter land +24
    ! W/m2); with 0.80 (+ &clouds rhc_ice) the cap is at ERA5's RH.
    rh_crit_ice = 0.80
    ! reevap: reevaporation efficiency [1/(kg/kg)] of falling precipitation into
    ! sub-saturated layers (SpeedyWeather ImplicitCondensation; 0 = off).
    ! cond_time_scale: 1/cond_time_scale of the saturation adjustment (and of
    ! the reevaporation) is applied per step [steps]; SpeedyWeather uses 3, and
    ! 1 is the exact one-step adjustment (see aeros_condensation, "The time scale").
    reevap          = 30.0
    cond_time_scale = 3.0
    ! Lid cold trap [kg/kg]: the top layer's condensation threshold is capped
    ! at min(rh_crit*q_sat, lid_q_max). <= 0 = off.
    lid_q_max       = 1.0e-5

    ! Moist convective adjustment (src/physics/aeros_convection.f90); the
    ! switch is &physics l_cnv. `conv_scheme` selects the scheme: "sbm"
    ! (Simplified Betts-Miller with the strictly-buoyant band),
    ! "sbm_frierson" (the default: the same closure with Frierson's
    ! surface-to-LZB depth + integrated Pt/Pq trigger, stays active at RCE
    ! and dries the free troposphere) or "manabe" (the parameter-free
    ! reference). conv_tau is the SBM relaxation time [s] and conv_rhref the
    ! reference relative humidity the moist adiabat is dried toward.
    conv_scheme = "sbm_frierson"
    conv_tau    = 14400.0
    conv_rhref  = 0.80
    ! Sub-cloud (mixed-layer) reference relative humidity for sbm_frierson.
    conv_rh_ref_bl   = 0.85
    ! CLIMBER-X RH-profile reference for the SBM cloud layer (vesta rh_prof):
    ! conv_rhref (CLIMBER-X's ram) up to conv_rh_zpbl, exp(-(z - zpbl)/hscale)
    ! to conv_rh_ztop, constant above. hscale <= 0 = the uniform conv_rhref
    ! (off). Adopted 2026-09-09 (run P6): anchor 0.80, z_pbl 500, h 3000 gives
    ! the tropical RH 40/34/44/71/86 % at sigma 0.36-0.96 (ERA5 37/45/56/70/84),
    ! clear-sky OLR 258 -> 262.5 (264). Needs &clouds rhc_ice 0.40, lwc 0.022e-3.
    conv_rh_hscale   = 3000.0
    conv_rh_zpbl     = 500.0
    conv_rh_ztop     = 3000.0
    ! Depth of the SBM's non-precipitating (shallow) relaxation as p/p_s: the
    ! cloud layer only, instead of up to the level of zero buoyancy. <= 0 = off.
    conv_shallow_sig = -1.0
    ! Dry convective adjustment run before the moist scheme.
    conv_dry_adjust  = .TRUE.
/

&surface
    ! Prescribed-SST surface energy/moisture budget (src/physics/aeros_surface.f90):
    ! bulk turbulent sensible + latent fluxes into the lowest layer, the source
    ! that closes the atmosphere's budget once Held-Suarez is removed. The
    ! switch is &physics l_surf. c_h/c_e are the exchange coefficients; the
    ! surface wind the fluxes see is sqrt((wind_slowdown*|V_low|)^2 +
    ! gust_speed^2) (SpeedyWeather's SurfaceCondition); the SST is the APE
    ! control profile, sst_eq K above freezing at the equator tapering to
    ! freezing poleward of sst_lat degrees.
    ! <= 0 = the surface-layer log law diagnosed per point from the bulk
    ! Richardson number of the lowest layer (virtual static energy jump skin ->
    ! level 1): stable, Frierson's kappa^2/ln^2(z1/z0)*(1-Ri/Ri_c)^2; unstable,
    ! Monin-Obukhov with Businger-Dyer psi functions (C_H = C_E, C_D separate).
    ! > 0 pins a fixed coefficient; c_d = 0 = no drag.
    c_h     = -1.0
    c_e     = -1.0
    z0_ocean = 1.0e-4
    z0_land  = 0.5
    ! Surface-layer critical bulk Richardson number (stable branch): Speedy-
    ! Weather's 10; Frierson (2006) uses 1. 1 since 2026-09-08: with 10 the
    ! winter NH land took 25 W/m2 of downward sensible heat (ERA5 8) through
    ! the 360 m log law over z0 = 0.5 m.
    ri_crit  = 1.0
    ! Land surface (canopy) resistance to evaporation [s/m], in series with the
    ! aerodynamic resistance (CLIMBER-X r_s = 1/(1.6 g_can); ebal_veg f_le).
    ! 0 = off. 100 set 2026-09-09 against the ERA5 April-June 40-70N land
    ! evaporation.
    r_s_land = 100.0
    gust_speed    = 5.0
    wind_slowdown = 0.95
    ! Momentum drag coefficient. Bulk stress tau = rho c_d |u| u, imposed
    ! implicitly as the momentum bottom BC in vdiff. 0 = no surface drag.
    c_d     = -1.0
    ! Floor of the diagnosed bulk transfer coefficient (heat, moisture and
    ! momentum). Keeps calm-surface fluxes off zero.
    cd_min  = 1.0e-5
/

&ocean
    ! The sea surface temperature (src/physics/aeros_ocean.f90) the surface
    ! fluxes and radiation run against. mode=0 prescribed (fixed APE SST, the
    ! aquaplanet control and default), mode=1 slab (SST evolves from the net
    ! surface energy flux). depth is the slab mixed-layer depth [m]; freeze_floor
    ! clamps SST >= 273.15 K (no sea ice). sst_eq/sst_lat set the APE profile:
    ! sst_eq K above freezing at the equator, frozen poleward of sst_lat degrees.
    mode         = 0
    depth        = 10.0
    freeze_floor = .TRUE.
    sst_eq       = 27.0
    sst_lat      = 60.0
    ! Meridional-shape argument multiplier: 1.5 is the APE Control profile
    ! (gradient steepest at 30 deg); 1.0 gives cos^2(phi), a smoother, more
    ! poleward SpeedyWeather-like profile (use with sst_lat = 90).
    sst_shape    = 1.5
    ! Thermodynamic sea ice (opt-in, switch &physics l_seaice). On, it REPLACES
    ! the freeze floor with a Semtner 0-layer ice model (needs a slab, mode=1):
    ! the mixed-layer deficit forms ice, ice grows/melts from the surface
    ! balance, and the surface albedo rises to ice_albedo where ice is present
    ! (the high-latitude feedback). k_ice is the ice conductivity, t_frz the
    ! seawater freezing point, ocn_albedo the open-water albedo. Off -> exact
    ! freeze-floor behaviour.
    ice_albedo   = 0.60
    ocn_albedo   = 0.06
    k_ice        = 2.0
    t_frz        = 271.35
/

&land
    ! Land surface (src/physics/aeros_land.f90). Read by aeros_land_load; the
    ! switch is &physics l_land (off -> all-ocean). The land-sea mask and the
    ! bare albedo are boundary fields (&boundary lsm / albedo: the ERA5
    ! climatologies by default, or a coupler push); this group holds the
    ! process tuning -- the coupled real-Earth calibration (formerly
    ! rce_defaults.nml).
    lsm_threshold    = 0.5      ! land where the lsm provider's fraction >= threshold
    w_field_capacity = 0.15     ! bucket capacity [m]
    w_crit           = -1.0     ! beta knee [m]; < 0 = 0.75 * w_field_capacity
    ! Effective seasonal soil heat capacity [J m-2 K-1] (~2.5e6 J m-3 K-1 over
    ! the ~2 m annual penetration depth). Recalibrated 2026-09-06 with the
    ! seasonal albedo: 2e6 -> 5e6 keeps JJA NH-land T within ~1 K of ERA5.
    c_soil           = 5.0e6
    land_albedo      = 0.20     ! bare land albedo [-] when &boundary albedo_kind = -1 (no provider)
    c_h_land         = 1.5e-3   ! land sensible exchange coefficient
    c_e_land         = 1.5e-3   ! land moisture exchange coefficient
    freeze_floor     = .FALSE.  ! clamp t_soil >= T0 (no snow)
    snow_albedo      = -1.0     ! snow-albedo feedback cold endpoint [-]; < 0 = off
    snow_dt          = 5.0      ! ramp width [K] below T0
    ! Frozen-ground evaporation factor on beta below T0 (ramped over snow_dt);
    ! 1 = off. 0.1 since 2026-09-08: the bucket evaporated 17-24 W/m2 from
    ! frozen NH winter land (ERA5 4-6), moistening the winter cap.
    beta_frozen      = 0.1
/

&radiation
    ! Longwave + shortwave (src/physics/aeros_radiation.f90); the switch is
    ! &physics l_rad. scheme = 2 is ecCKD (correlated-k, the production
    ! default: better clear-sky OLR, CO2 forcing and LW cloud effect), 1 the
    ! ported SESAM band kernel (fast, bit-reproducible fallback); co2_ppm the
    ! CO2 volume mixing ratio; l_o3 the prescribed analytic ozone (a diagnostic
    ! switch, not a tuning lever); albedo the ocean surface broadband albedo
    ! (&ocean ocn_albedo is the slab/sea-ice module's own open-water albedo --
    ! keep the two equal); tsi the solar constant [W/m2]; seasonal toggles the
    ! daily-mean seasonal cycle from the Laskar orbit (else annual-mean);
    ! interval the recompute cadence [s]; doy0 the start day-of-year in
    ! seasonal mode. clouds turns on the diagnostic all-sky path (&clouds +
    ! the cloudy kernels); OFF => clear-sky (forced ON by &physics
    ! l_cloud_prog, whose fraction is only consumed through this path). The
    ! real-Earth cases run clouds + seasonal on.
    scheme   = 2
    co2_ppm  = 280.0
    l_o3     = .TRUE.
    clouds   = .FALSE.
    albedo   = 0.06
    ! Background aerosol in the clear-sky SW (aeros_sw_aerosol: the SESAM
    ! aerosol branch, CLIMBER-X ars_ot/ars_im): uniform, constant optical
    ! thickness and imaginary refractive index -- climate-independent, so valid
    ! for present day, climate change and paleo alike. Calibrated 2026-09-09 on
    ! validate_era5 to close the clean 40-60S ocean clear-sky surface SW. 0 = off.
    aer_ot   = 0.12
    aer_im   = 0.02
    ! Sulfate direct effect (CLIMBER-X l_so4_de, Bauer et al. 2008) on the
    ! sulfate load of the &boundary so4 provider (the CMIP6 historical
    ! ensemble mean at a calendar year by default; so4_kind = -1 or a
    ! so4_kind = 0 / so4_value = 0 constant for paleo).
    ! Sulfate indirect effect (CLIMBER-X l_so4_ie): liquid cloud water x
    ! f_mod^(1/3) from the sulfate number at cloud base (no-op at so4 = 0).
    so4_indirect = .true.
    ! Dust optical thickness of the &boundary dust provider (monthly maps,
    ! scaled there by dust_scale) added to the background aerosol per column;
    ! dust_im its imaginary refractive index (CLIMBER-X ars_im).
    dust_im    = 0.01
    tsi      = 1361.0
    seasonal = .FALSE.
    interval = 21600.0
    doy0     = 0.0
    ! Backward-compat mirror of `&insolation/time_bp` -- read at
    ! src/physics/aeros_radiation.f90:411 (Wave 1 legacy read). Wave 4 will
    ! unify the two; keep this in sync with &insolation until then.
    time_bp  = 0.0
    ! ecCKD near-IR H2O band knobs (aeros_ecckd module state, folded into
    ! aeros_radiation_load Wave 1). Defaults match the compile-time defaults;
    ! overriding them is a calibration path, not production tuning.
    ecckd_a1_w = 0.21
    ecckd_b1_w = 6.27
    ecckd_b2_w = 0.0267
/

&insolation
    ! Insolation (src/physics/aeros_insolation.f90) via the LA2004 orbit. Wave 1
    ! adds aeros_insol_load reading this group; the same time_bp / seasonal
    ! keys still live in &radiation for backward compatibility and are read
    ! there by aeros_radiation_load. Wave 4 will unify them here.
    time_bp  = 0.0        ! orbital year before present (1950 CE); 0 = present-day
    seasonal = .FALSE.    ! .FALSE. = annual-mean insolation
    fldr     = "insol/input"
/

&clouds
    ! Diagnostic RH-based cloud scheme (src/physics/aeros_cloud.f90; used when
    ! &radiation clouds is on and &physics l_cloud_prog off): critical-RH
    ! endpoints at the surface / model top (Sundqvist fraction) and in-cloud
    ! liquid / ice water contents [kg m-3]. The coupled real-Earth calibration
    ! (2026-09-06..09) against ERA5's TOA budget: rhc_top above 1 puts the lid
    ! layer's threshold at ~1 (that layer sits at RH 90 % by construction and
    ! its "cloud" was a black 231 K deck); rhc_ice 0.40 with the SBM reference
    ! profile (tropical UT at RH 40 %); lwc 0.022e-3 with the sulfate indirect
    ! effect: SW CRE -45 (ERA5 -46), TOA -0.1. The module's own compile-time
    ! defaults (0.52/0.35, 0.017/0.018) are the offline ERA5-column
    ! calibration (docs/m2_results.md section 19) and stay for validate_era5.
    rhc_sfc = 0.52      ! critical RH at the surface (sigma = 1)
    rhc_top = 1.03      ! critical RH at the top (sigma = 0)
    rhc_ice = 0.40      ! ice-phase critical RH: min(rhc(sigma), rhc_ice) for the ice fraction; < 0 = off
    lwc     = 0.022e-3  ! in-cloud liquid water content [kg m-3]
    iwc     = 0.014e-3  ! in-cloud ice water content    [kg m-3]
/

&aeros_cloud
    ! Prognostic cloud-fraction scheme (Sundqvist 1989),
    ! src/physics/aeros_cloud_prog.f90. Read by aeros_cloud_prog_load; the
    ! switch is &physics l_cloud_prog (off -> bit-for-bit vs the diagnostic
    ! path). Defaults match the aeros_cloud_prog_class initializers (src lines
    ! 88-106).
    cloud_rhc_sfc  = 0.40      ! critical RH at the surface (sigma = 1)
    cloud_rhc_top  = 0.60      ! critical RH at the top (sigma = 0)
    cloud_tau_form = 10800.0   ! formation relaxation timescale [s]
    cloud_tau_evap = 10800.0   ! evaporation relaxation timescale [s]
    cloud_c_detr   = 0.5       ! convective-detrainment anvil ceiling [-]
/

&vdiff
    ! Boundary-layer vertical diffusion (src/physics/aeros_vdiff.f90): mixes the
    ! surface source up the column (implicit on the n+1 state); the switch is
    ! &physics l_vdiff.
    ! richardson = .TRUE. uses the Frierson (2006) / SpeedyWeather bulk-Ri
    ! diagnosed depth and K-profile (ri_crit, z0, von_karman, surf_frac apply);
    ! .FALSE. is the legacy fixed-depth scheme (k0 is the eddy diffusivity
    ! [m2/s], sigma the boundary-layer top). Both diffuse dry static energy.
    ! k0 = 10 is the module default; the real-Earth cases run 25.
    richardson = .TRUE.
    k0         = 10.0
    sigma      = 0.7
    ri_crit    = 10.0
    z0         = 3.21e-5
    von_karman = 0.4
    surf_frac  = 0.1
/

&bd
    ! Prescribed Brewer-Dobson residual circulation in the lid layer
    ! (src/physics/aeros_bd.f90). Runs when &physics l_bd is on AND `file` is
    ! non-empty (an empty file forces off). `file` is the netCDF climatology of
    ! w*(lat,month) and its reference stability; `scale` a global amplitude
    ! factor; `per_k` a fractional change of w* per K of running annual
    ! global-mean lowest-level T anomaly from `t_ref`; `tau_mean_days` the
    ! running-mean time scale [days]. The file w* was backed out of the L6 run
    ! relaxed toward the ERA5 layer-mean lid (2026-09-08); the lid stays
    ! radiatively interactive. per_k: stratosphere-resolving models give
    ! +0.02..0.03 per K of warming (imposed, not emergent).
    file          = "input/bd_wstar_era5.nc"
    scale         = 1.0
    per_k         = 0.0
    t_ref         = 285.0
    tau_mean_days = 365.0
/

&boundary
    ! Boundary providers (docs/coupling_api.md sec 7,
    ! src/physics/aeros_boundary.f90): the ONE source of every externally
    ! prescribed field. One provider per lower-boundary / forcing field:
    !   kind = -1 (BC_NONE)      no provider; the consumer keeps its own
    !                            default (analytic SST, scalar land_albedo,
    !                            all ocean, no dust / sulfate, flat surface)
    !   kind =  0 (BC_CONSTANT)  uniform X_value
    !   kind =  1 (BC_FILE)      X_file / X_varname regridded onto the model
    !                            grid: 12 monthly slices interpolated to the
    !                            day when X_is_monthly, else the slice X_itime
    !                            (0 = the time-mean of the file); a variable
    !                            with no longitude dimension is a zonal table
    !                            (lat[,month]) on the model latitudes and is
    !                            broadcast along longitude
    !   kind =  2 (BC_EXTERNAL)  pushed by a coupler through
    !                            aeros_lib_step(imports=...)
    ! The library hands every buffer to its consumer (aeros_boundary_apply):
    ! sst -> the prescribed SST (&ocean mode = 0), lsm / albedo -> the land
    ! mask and bare albedo (&physics l_land), dust / so4 -> the radiation
    ! aerosol maps (l_rad), phis -> the orography, band-limited to the model
    ! truncation (l_topography). A provider whose consumer is off is neither
    ! read nor applied, so the calibrated real-Earth files named below cost
    ! an aquaplanet or dry-core run nothing.
    !
    ! Per-2D-provider keys:
    !   X_kind, X_file, X_varname, X_lon_name ("longitude"), X_lat_name
    !   ("latitude"), X_is_monthly, X_itime (single-slice; 0 = time-mean),
    !   X_value (CONSTANT uniform fill), X_scale (post-read multiplier),
    !   X_floor (post-read clamp, max(X_floor, X_scale*x); keep at large
    !   negative to disable).
    ! Per-scalar-provider keys:
    !   X_kind, X_value, X_file, X_year.

    ! Prescribed SST (&ocean mode = 0): the ERA5 skt-derived seasonal table
    ! (scripts; ocean-masked, land-filled), refreshed daily. -1 = the
    ! analytic APE profile of &ocean (the aquaplanet control).
    sst_kind         = 1
    sst_file         = "input/sst_seasonal_2d.nc"
    sst_varname      = "sst"
    sst_lon_name     = "longitude"
    sst_lat_name     = "latitude"
    sst_is_monthly   = .TRUE.
    sst_itime        = 1
    sst_value        = 0.0
    sst_scale        = 1.0
    sst_floor        = -1.0e30

    sic_kind         = 0
    sic_file         = ""
    sic_varname      = "sic"
    sic_lon_name     = "longitude"
    sic_lat_name     = "latitude"
    sic_is_monthly   = .TRUE.
    sic_itime        = 1
    sic_value        = 0.0
    sic_scale        = 1.0
    sic_floor        = -1.0e30

    t_ice_sfc_kind       = 0
    t_ice_sfc_file       = ""
    t_ice_sfc_varname    = ""
    t_ice_sfc_lon_name   = "longitude"
    t_ice_sfc_lat_name   = "latitude"
    t_ice_sfc_is_monthly = .FALSE.
    t_ice_sfc_itime      = 1
    t_ice_sfc_value      = 0.0
    t_ice_sfc_scale      = 1.0
    t_ice_sfc_floor      = -1.0e30

    t_skin_land_kind       = 0
    t_skin_land_file       = ""
    t_skin_land_varname    = ""
    t_skin_land_lon_name   = "longitude"
    t_skin_land_lat_name   = "latitude"
    t_skin_land_is_monthly = .FALSE.
    t_skin_land_itime      = 1
    t_skin_land_value      = 0.0
    t_skin_land_scale      = 1.0
    t_skin_land_floor      = -1.0e30

    q_skin_land_kind       = 0
    q_skin_land_file       = ""
    q_skin_land_varname    = ""
    q_skin_land_lon_name   = "longitude"
    q_skin_land_lat_name   = "latitude"
    q_skin_land_is_monthly = .FALSE.
    q_skin_land_itime      = 1
    q_skin_land_value      = 0.0
    q_skin_land_scale      = 1.0
    q_skin_land_floor      = -1.0e30

    ! Bare land albedo (&physics l_land): the monthly ERA5 forecast albedo
    ! (fal), interpolated daily -- its annual mean is snow-contaminated (0.36
    ! at 65N) and leaves summer high-latitude land ~6 K too cold. -1 = the
    ! scalar &land land_albedo.
    albedo_kind       = 1
    albedo_file       = "/Users/alrobi001/data/era5/monthly-single-levels/era5_monthly-single-levels_fal_1991-2020_clim.nc"
    albedo_varname    = "fal"
    albedo_lon_name   = "longitude"
    albedo_lat_name   = "latitude"
    albedo_is_monthly = .TRUE.
    albedo_itime      = 1
    albedo_value      = 0.06
    albedo_scale      = 1.0
    albedo_floor      = -1.0e30

    z0m_kind       = 0
    z0m_file       = ""
    z0m_varname    = ""
    z0m_lon_name   = "longitude"
    z0m_lat_name   = "latitude"
    z0m_is_monthly = .FALSE.
    z0m_itime      = 1
    z0m_value      = 1.0e-4
    z0m_scale      = 1.0
    z0m_floor      = -1.0e30

    ! Surface geopotential (&physics l_topography): ERA5 z [m2 s-2] -- already
    ! a geopotential, no multiply by g -- time-mean of the (single-record)
    ! file, spectrally band-limited to the model truncation by the library.
    phis_kind       = 1
    phis_file       = "/Users/alrobi001/data/era5/era5_orography.nc"
    phis_varname    = "z"
    phis_lon_name   = "longitude"
    phis_lat_name   = "latitude"
    phis_is_monthly = .FALSE.
    phis_itime      = 0
    phis_value      = 0.0
    phis_scale      = 1.0
    phis_floor      = -1.0e30
    ! Orography spin-up ramp [days], applied by a driver (rce_long): the
    ! dynamics sees phis scaled linearly from 0 to full over this many days
    ! (aeros_topography_scale, a pure function of elapsed time, hence
    ! restart-safe) to spread the spin-up shock; 0 = full from t = 0. The
    ! library itself always applies the full field.
    phis_ramp_days  = 20.0

    ! Land-sea mask (&physics l_land): the ERA5 land fraction, time-mean of
    ! the file, thresholded at &land lsm_threshold.
    lsm_kind       = 1
    lsm_file       = "/Users/alrobi001/data/era5/monthly-single-levels/era5_monthly-single-levels_lsm_1991-2020_clim.nc"
    lsm_varname    = "lsm"
    lsm_lon_name   = "longitude"
    lsm_lat_name   = "latitude"
    lsm_is_monthly = .FALSE.
    lsm_itime      = 0
    lsm_value      = 0.0
    lsm_scale      = 1.0
    lsm_floor      = -1.0e30

    ! Dust optical thickness (&physics l_rad): monthly 5x5 maps from
    ! scripts/dust_ot_from_deposition.py on CLIMBER-X's fake_dust_*
    ! deposition (Lambert et al. 2015 present day here; the _lgm file for
    ! the LGM), interpolated daily, clamped at 0. dust_scale 0.3
    ! (2026-09-09): the inversion assumes the fine, transported mode
    ! everywhere, but source-region deposition is coarse fall-out, so the
    ! unscaled map is ~3x ERA5's Saharan clear-sky effect. -1 = no dust.
    dust_kind       = 1
    dust_file       = "input/dust_ot_lambert2015_present.nc"
    dust_varname    = "dust_ot"
    dust_lon_name   = "lon"
    dust_lat_name   = "lat"
    dust_is_monthly = .TRUE.
    dust_itime      = 1
    dust_value      = 0.0
    dust_scale      = 0.3
    dust_floor      = 0.0

    ! Sulfate load [kg m-2] (&physics l_rad; the direct and indirect effects
    ! of &radiation): the CMIP6 historical ensemble mean (CLIMBER-X input,
    ! 5x5, one annual record per year 1850-2014), clamped at 0. The record
    ! is selected by index: so4_itime = year - 1850 + 1, i.e. 154 = 2003, the
    ! present-day calibration year (ERA5 1991-2020 mid-point). Paleo: -1
    ! (none) or a constant, so4_kind = 0 with so4_value.
    so4_kind       = 1
    so4_file       = "/Users/alrobi001/models/climber-x/input/so4_historical_CMIP6_ensmean_ann_5x5.nc"
    so4_varname    = "so4"
    so4_lon_name   = "lon"
    so4_lat_name   = "lat"
    so4_is_monthly = .FALSE.
    so4_itime      = 154
    so4_value      = 0.0
    so4_scale      = 1.0
    so4_floor      = 0.0

    o3_kind       = 0
    o3_file       = ""
    o3_varname    = ""
    o3_lon_name   = "longitude"
    o3_lat_name   = "latitude"
    o3_is_monthly = .FALSE.
    o3_itime      = 1
    o3_value      = 0.0
    o3_scale      = 1.0
    o3_floor      = -1.0e30

    ! Scalar (year-boundary) fields. FILE readers for these are Phase C;
    ! Wave 2 accepts the type only, with kind = 0 (CONSTANT) as the default.
    co2_kind  = 0
    co2_value = 280.0
    co2_file  = ""
    co2_year  = 2000

    ch4_kind  = 0
    ch4_value = 700.0
    ch4_file  = ""
    ch4_year  = 2000

    n2o_kind  = 0
    n2o_value = 270.0
    n2o_file  = ""
    n2o_year  = 2000

    time_bp_kind  = 0
    time_bp_value = 0.0
    time_bp_file  = ""
    time_bp_year  = 2000

    tsi_kind  = 0
    tsi_value = 1365.0
    tsi_file  = ""
    tsi_year  = 2000
/

&rce
    ! The rce_long DRIVER's own keys (drivers/rce_long.f90) -- run control,
    ! output, checkpoints and the diagnostic probes. Every physics / dynamics
    ! knob rce_long used to read from this group lives in its subsystem group
    ! above since Wave 4a.2 (the driver initialises through aeros_lib_init);
    ! the seasonal-insolation flags it consults are &radiation seasonal / doy0.

    ! Run length [steps] and the trajectory-report cadence [steps].
    nstep            = 4800
    print_every      = 96

    ! Per-term heating split at the hot latitude + the second-half zonal-mean
    ! accumulators (aeros_timestep_enable_diag; adds diagnostic work arrays).
    l_diag           = .TRUE.

    ! Monthly-mean climatology output path. "" = off. Set to a .nc path to bin
    ! zonal-mean T/u/RH/v (lat,lev,month), the 2D surface fields and the eddy
    ! covariances by calendar month for the ERA5 seasonal comparison
    ! (mwm/D_realearth). mon_spinup_days: spin-up days excluded from the
    ! climatology (0 = accumulate all).
    monthly_out      = ""
    mon_spinup_days  = 0.0

    ! Checkpoint / restart. restart_in: resume from this file ("" = cold start,
    ! the rce_warm IC). restart_out: write checkpoints here ("" = none);
    ! restart_interval: every N steps (0 = only at the end).
    restart_in       = ""
    restart_out      = ""
    restart_interval = 0

    ! The prescribed fields this driver used to read itself -- the orography
    ! (topo_file) and the seasonal SST table (sst_seasonal_file) -- are
    ! &boundary providers since Wave 4b (phis, sst); the orography ramp is
    ! &boundary phis_ramp_days. With l_topography the band-limited orography
    ! is dumped to output/rce_phis.nc.

    ! Diagnostic probes. l_uniform_insol flattens the insolation to its global
    ! mean (no meridional gradient; with &aeros l_nonrotating the single-column
    ! RCE vehicle) and starts from the gradient-free rce_warm IC. l_qforce
    ! replaces the physics by an analytic Q(lat,sigma) = qforce_amp [K/day] x
    ! [equatorial, zero-mean] x sin(pi sigma) on the in-solve seam (set all
    ! physics off).
    l_uniform_insol  = .FALSE.
    l_qforce         = .FALSE.
    qforce_amp       = 2.0
/
