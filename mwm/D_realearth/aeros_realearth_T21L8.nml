! Real-Earth harness case (mwm/D_realearth): what this experiment SETS.
! Everything not listed takes the calibrated default in
! input/aeros_defaults.nml (the schema); rce_long reads its own &rce group
! and initialises the model through aeros_lib_init.

&aeros
    trunc = 21
    nlev  = 8
    dt    = 1800.0
    seed_asym     = 0.0        ! axisymmetric start (land/topography break the symmetry)
    l_nonrotating = .false.
/

&physics
    l_surf       = .true.
    l_cnv        = .true.
    l_cnd        = .true.
    l_rad        = .true.
    l_vdiff      = .true.
    l_land       = .true.
    l_topography = .true.
/

&aeros_moisture
    rh_crit         = 0.93
    conv_tau        = 14400.0
    conv_dry_adjust = .true.
/

&vdiff
    k0    = 25.0
    sigma = 0.7
/

&radiation
    clouds   = .true.      ! diagnostic all-sky clouds (&clouds)
    seasonal = .true.      ! Laskar-orbit seasonal insolation
    doy0     = 0.0
    albedo   = 0.06        ! ocean surface albedo; keep equal to &ocean ocn_albedo
    co2_ppm  = 280.0
/

&ocean
    mode       = 0         ! prescribed SST (&boundary sst: the seasonal ERA5 table)
    depth      = 10.0
    ocn_albedo = 0.06
/

&land
    c_soil      = 5.0e6
    snow_albedo = -1.0
    snow_dt     = 5.0
/

&boundary
    phis_ramp_days = 20.0    ! orography spin-up ramp (rce_long)
/

&rce
    nstep             = 52560
    print_every       = 17520
    l_diag            = .false.
    l_uniform_insol   = .false.
    monthly_out       = "mwm/D_realearth/output/aeros_realearth_T21L8.nc"
    mon_spinup_days   = 730.0
/
