&bench
    ! Free-text label for this machine/run, carried into the CSV so a laptop
    ! run and an HPC run can sit in the same file and be told apart. Overridable
    ! as the second command-line argument.
    label = "macbook-m5-10core"

    ! Sweep lists. Up to 8 entries each; 0 or absent entries are skipped.
    !
    ! T31 and T42 are the two candidates for the production truncation
    ! (docs/design.md section 10.3). T85 is the reference truncation the
    ! section 3.7 correction is diagnosed against, so its cost sets the
    ! refresh budget.
    truncs = 31, 42, 85

    ! L8 is SpeedyWeather's configuration -- the anchor section 11 extrapolated
    ! from -- so it is included to check that extrapolation directly.
    ! L16-20 is the design target (section 4.1).
    nlevs = 8, 16, 20

    ! Thread counts. 0 entries are skipped; the list is capped by the pool,
    ! which is built for exactly this many threads.
    !
    ! NOTE: the decision this benchmark exists to inform (T31+correction vs
    ! bare T42, section 3.6) turns on effective thread count >= ~24, which a
    ! 10-core laptop cannot reach. On this machine the sweep measures the
    ! single-core cost and the shape of the curve; the decision waits for the
    ! HPC. Extend this list to 16, 32, 64 there.
    threads = 1, 2, 4, 8, 10

    ! Scalar-equivalent transforms per level per timestep. The headline cost
    ! scales linearly in this.
    !
    ! MEASURED at M1.3, from what src/dynamics/aeros_tendency.f90 actually does
    ! for the DRY core:
    !   synthesis  (u,v) [vector = 2] + zeta + D + T + grad(T) [vector = 2] = 7
    !   analysis   momentum RHS [vector = 2] + (Phi+K) + dT/dt              = 4
    ! Single-level work (ln p_s and its gradient) is neglected as O(1/nlev).
    !
    ! The original estimate here was 8; the dry core needs 11. Moisture (M2)
    ! adds a q synthesis and a q-tendency analysis, so expect 13 there.
    ntr_per_level = 11

    ! Dynamics timestep [s]. ~30 min at T42 (docs/design.md section 4).
    ! Held fixed across truncations here so the numbers isolate the cost of
    ! resolution; a real T85 run would need a shorter step, which makes the
    ! T85 cost reported below an UNDER-estimate per model year.
    dt = 1800.0

    ! Timed repeats per case.
    nrep = 20

    csv_out = "logs/bench_m0a.csv"
/
