! aeros case (parameter) file.
!
! With the defaults paradigm this need only carry what differs from the schema
! in input/aeros_defaults.nml -- every parameter not listed here takes its value
! from there (see nml_read's defaults_file; aeros_run passes it automatically).
! So a case file is the CHANGES for this run, not the full parameter set. List
! any group/parameter from the defaults file here to override it.
!
! This shipped case overrides nothing but the run control, so it runs the
! default (dry, all physics off) dynamics from the resting isothermal state.

&ctrl
    ! Times in YEARS. 0.1 yr at dt = 1800 s is ~1750 steps -- a smoke test. With
    ! no forcing enabled the resting isothermal start should stay put; that IS
    ! the check.
    time_init  = 0.0
    time_end   = 0.1
    dt_out     = 0.02
    file_out   = "aeros.nc"
/
