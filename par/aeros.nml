&ctrl
    ! Times in YEARS. aeros_update converts to the dynamics timestep itself and
    ! derives the step count from the absolute elapsed time, so an output
    ! interval that is not a whole number of steps is fine and does not drift.
    !
    ! 0.1 yr at dt = 1800 s is ~1750 steps -- a smoke test rather than a
    ! simulation. There is no forcing until M1.5, so a run from the shipped
    ! initial condition (a resting isothermal atmosphere) should stay exactly
    ! where it started; that IS the check this default performs.
    time_init  = 0.0
    time_end   = 0.1
    dt_out     = 0.02
    file_out   = "aeros.nc"
/

&aeros
    ! Triangular truncation T.
    !   T21 ->  64x32   (ruled out for production: fails both NH ice sheets)
    !   T31 ->  96x48
    !   T42 -> 128x64
    !   T85 -> 256x128  (the reference truncation for the section 3.7 correction)
    !
    ! DEVELOPMENT DEFAULT: T31, for speed. This is NOT the production choice.
    !
    ! docs/design.md section 10.3 frames T31-plus-correction vs bare T42 as the
    ! central open question and expects the cost measurement to settle it. M0a
    ! has now removed the COST half of that argument -- T42 measures at ~14% of
    ! the coupled budget, not 82% (docs/m0a_results.md section 2) -- so T42 is
    ! affordable. What remains is the accuracy half, which no benchmark can
    ! answer: whether T42 alone builds the Eurasian ice sheet.
    !
    ! Decision (AR, 2026-07-24): stay at T31 for day-to-day work, test at T42
    ! periodically, and settle the production truncation with the full model
    ! rather than with the dynamical core. Nothing in the code may assume a
    ! value; changing this line is the only thing required to switch.
    trunc    = 31

    ! Gaussian grid. -1 selects the smallest quadratically-unaliased grid for
    ! `trunc`, which is what production should use. Set explicitly only to
    ! study aliasing or to match another model's grid.
    nlon     = -1
    nlat     = -1

    ! Vertical levels. docs/design.md section 4.1: L16-20, with 3-4 levels
    ! below 850 hPa. Fix this before tuning anything -- level count moves the
    ! jet latitude, and therefore the storm track, and therefore ice-sheet
    ! precipitation.
    nlev     = 16

    ! Dynamics timestep [s]. ~30 min at T42 (section 4).
    !
    ! The semi-implicit solve is what makes this affordable: the explicit
    ! gravity-wave limit is ~600 s at T31L20 and ~450 s at T42, both printed at
    ! run start by aeros_semiimp_print. Raising dt above ~2x the ADVECTIVE CFL
    ! is not protected by the semi-implicit scheme -- it only handles the
    ! gravity waves.
    dt       = 1800.0

    ! Semi-implicit leapfrog (.TRUE.) or fully explicit leapfrog (.FALSE.).
    ! Explicit is not a production configuration; it exists so the value of the
    ! semi-implicit solve is measured rather than asserted. With it, dt must
    ! fall below the explicit limit above or the run diverges within ~20 steps.
    semi_implicit = .TRUE.

    ! Time filter. Williams (2009) RAW: nu is the classical Robert-Asselin
    ! coefficient and alpha splits the displacement between the two time
    ! levels. alpha = 1.0 recovers the classical filter exactly, which is the
    ! comparison to run if the filter is ever suspected.
    !
    ! nu = 0.06 is mid-range for a spectral model of this size; alpha = 0.53 is
    ! Williams' recommended value, and buys third-order amplitude accuracy and
    ! exact conservation of the mean -- which is what matters over 10^5 yr,
    ! where the classical filter's mean damping is a slow drift rather than a
    ! transient.
    eps_filter = 0.06
    raw_alpha  = 0.53

    ! Horizontal hyperdiffusion, applied implicitly to vorticity, divergence
    ! and temperature (never to ln p_s -- that would leak mass).
    !
    ! ndiff is the order: 6 = del^6, the usual choice for a T31-T85 spectral
    ! core. Lower orders damp the resolved scales too broadly; higher ones make
    ! the operator so scale-selective that the last wavenumber is the only one
    ! affected at all.
    !
    ! tau_diff [h] is the e-folding time of the l = lmax wave. 6 h is a
    ! conventional starting value; it is a TUNING parameter, and the right
    ! value depends on truncation and on how vigorous the flow is. Retune it
    ! when the truncation changes, and check it against the enstrophy spectrum
    ! rather than against the look of a single field.
    ndiff    = 6
    tau_diff = 6.0

    ! OpenMP threads, i.e. the size of the SHTns config pool. -1 leaves it to
    ! OMP_NUM_THREADS. The M0a scaling sweep still has to be run at 16/32/64 on
    ! the HPC -- see docs/m0a_results.md section 4 caveat 4.
    nthreads = -1
/

&aeros_vert
    ! Vertical coordinate: hybrid sigma-pressure (Simmons & Burridge 1981),
    !     p_(k+1/2) = A_(k+1/2) + B_(k+1/2) * p_s
    ! generated from a stretched sigma profile. See src/dynamics/aeros_vertical.f90.

    ! Level placement. Spacing is proportional to stretch_a at the surface and
    ! to stretch_a + stretch_r*(1-stretch_a) at the top, so SMALLER stretch_a
    ! means finer resolution near the ground.
    !
    ! 0.4 / 2.0 gives 4 full levels below 850 hPa at L16 and 5 at L20 --
    ! docs/design.md section 4.1 asks for 3-4, because the polar winter
    ! boundary layer is 50-200 m deep with 10-25 K inversions -- while keeping
    ! 3 levels above 200 hPa. Section 4.1 also warns that level count moves the jet latitude
    ! and hence the storm track, so do not starve the upper troposphere to feed
    ! the boundary layer.
    !
    ! stretch_a = 1.0 gives EVENLY SPACED sigma, the Held-Suarez configuration.
    stretch_a = 0.4
    stretch_r = 2.0

    ! Hybrid transition: B = 0 (pure pressure) above this sigma, ramping to 1
    ! at the surface. 0.0 gives pure sigma exactly, with A = 0 everywhere.
    sigma_t   = 0.2

    ! Model top [Pa]. Low-top is accepted (docs/design.md section 4.1: give up
    ! on the QBO); must be > 0 for a hybrid coordinate.
    p_top     = 1000.0

    ! Reference state for the semi-implicit solve (M1.4). Isothermal, and
    ! deliberately warm: the scheme is stable when the reference temperature is
    ! at or above the column temperature and unstable well below it, so the
    ! error is one-sided.
    ps_ref    = 1.0e5
    t_ref     = 300.0
/
