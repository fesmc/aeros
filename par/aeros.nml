&ctrl
    time_init  = 0.0
    time_end   = 10.0
    dt_out     = 1.0
    file_out   = "aeros.nc"
/

&aeros
    ! Triangular truncation T.
    !   T21 ->  64x32   (ruled out for production: fails both NH ice sheets)
    !   T31 ->  96x48
    !   T42 -> 128x64
    !   T85 -> 256x128  (the reference truncation for the section 3.7 correction)
    !
    ! DEVELOPMENT DEFAULT: T31, for speed. This is NOT the production choice.
    !
    ! docs/design.md section 10.3 frames T31-plus-correction vs bare T42 as the
    ! central open question and expects the cost measurement to settle it. M0a
    ! has now removed the COST half of that argument -- T42 measures at ~14% of
    ! the coupled budget, not 82% (docs/m0a_results.md section 2) -- so T42 is
    ! affordable. What remains is the accuracy half, which no benchmark can
    ! answer: whether T42 alone builds the Eurasian ice sheet.
    !
    ! Decision (AR, 2026-07-24): stay at T31 for day-to-day work, test at T42
    ! periodically, and settle the production truncation with the full model
    ! rather than with the dynamical core. Nothing in the code may assume a
    ! value; changing this line is the only thing required to switch.
    trunc    = 31

    ! Gaussian grid. -1 selects the smallest quadratically-unaliased grid for
    ! `trunc`, which is what production should use. Set explicitly only to
    ! study aliasing or to match another model's grid.
    nlon     = -1
    nlat     = -1

    ! Vertical levels. docs/design.md section 4.1: L16-20, with 3-4 levels
    ! below 850 hPa. Fix this before tuning anything -- level count moves the
    ! jet latitude, and therefore the storm track, and therefore ice-sheet
    ! precipitation.
    nlev     = 16

    ! Dynamics timestep [s]. ~30 min at T42 (section 4).
    dt       = 1800.0

    ! OpenMP threads for the spectral transforms. -1 leaves it to
    ! OMP_NUM_THREADS. The M0a scaling measurement (section 7) sweeps
    ! 8/16/32/64 through this parameter.
    nthreads = -1
/
