# Generated by configme. Anchored to the repo root: config/Makefile is the
# TEMPLATE and must stay tracked. An unanchored "Makefile" pattern matches at
# every level and silently excludes it.
/Makefile

# Build products
libaeros/include/*
libaeros/bin/*
!libaeros/include/.gitkeep
!libaeros/bin/.gitkeep
*.o
*.mod
*.a
*.x

# Dependency slots (symlinked or cloned by configme)
fesm-utils

# Build provenance
git_aeros.txt

# Run output. The anchored *.nc catches a driver run by hand from the repo
# root; under runme the output lands in the staged run directory instead.
/*.nc
output/
logs/
tmp/

# Regridding weight caches (coords map_init). Regenerated on the fly; can be
# large, so never tracked.
maps/

# runme per-user config
.runme/config.toml

# macOS
.DS_Store

# SHTns tuning cache (SHT_LOAD_SAVE_CFG), written into the working dir
shtns_cfg
shtns_cfg_fftw
insol

# Claude Code worktrees / local session data
.claude/
